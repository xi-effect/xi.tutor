VITE_SERVER_URL_BACKEND=https://api.sovlium.ru
VITE_SERVER_URL_SOCKETIO=https://api.sovlium.ru
VITE_SERVER_URL_LIVEKIT=https://livekit.sovlium.ru
VITE_SERVER_URL_HOCUS=https://hocus.sovlium.ru
VITE_APP_DOMAIN=https://app.sovlium.ru
VITE_BUGSINK_DSN=
# Remote UI: production desktop must load *.sovlium.ru (same-site cookies).
# Keep this EXPLICIT — do not rely on import.meta.env.PROD alone; Vite may
# otherwise pick up VITE_TAURI_REMOTE_MODE=false from a leaked shell/dev env.
VITE_TAURI_REMOTE_MODE=true
VITE_TAURI_REMOTE_URL=https://app.sovlium.ru
VITE_TAURI_REMOTE_FALLBACK_URL=https://desktop.sovlium.ru
VITE_TAURI_REMOTE_TIMEOUT_MS=5000
VITE_TAURI_UPDATER_AUTOCHECK=true
# TEMP only for local-bundle auth experiments against api.sovlium.ru.
# Do not enable for remote mode or distribution builds.
VITE_TAURI_CROSS_SITE_SESSION_PROBE=false
