{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "iOS / Android: same WebAPI IPC as the shell (notifications, clipboard, files, opener, media). Store updates, no desktop window chrome.",
  "platforms": ["iOS", "android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "dialog:default",
    "notification:default",
    "os:default",
    "log:default",
    "deep-link:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-html",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" },
        { "url": "mailto:*" },
        { "url": "tg:*" },
        { "url": "telegram:*" }
      ]
    }
  ]
}